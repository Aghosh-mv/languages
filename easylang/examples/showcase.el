# EasyLang showcase - multiple syntax styles!

# Variables - choose your style:
let x = 10
set z to 30
create v = 50

# Print - many synonyms:
print "Hello!"
say "World!"
output "Easy!"
show "Code!"
tell "Me!"

# Control flow - natural language:
if x > 5 then
  print "x is big!"
end

# Loops - pick what feels right:
repeat 3 times
  print "Once!"
done

loop 3x
  print "Twice!"
end

# Functions - multiple styles:
function greet(name)
  print "Hello, " + name + "!"
end

to farewell(name)
  say "Goodbye, " + name + "!"
done

define add(a, b)
  return a + b
done

# Use them:
greet("Alice")
farewell("Bob")
print add(10, 20)

# Math operators - natural language:
let result = 10 + 5
let diff = 10 - 3
let product = 4 * 5
let quotient = 20 / 4
let power = 2 ** 8

# Comparison - write like English:
if result > 10
  print "Big result!"
end

if diff < 10
  print "Small difference!"
end

if product == 20
  print "Exact match!"
end
